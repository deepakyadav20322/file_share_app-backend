
APP_BASE_URL=http://localhost:3000
MONGO_CONNECTION_URL= mongodb://127.0.0.1:27017/fileShare
PORT=3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# These are dummy value please change according to you... 
MAIL_USER = your-email@gmail.com
MAIL_PASSWORD = 'your email app password'
ALLOWED_CLIENTS=http://localhost:3000,http://localhost:3001

# ---- New "Transfer" page (key / QR sharing) ----
LIVE_APP_BASE_URL=http://localhost:3000

# Limits (single place to change them)
MAX_FILES=5
MAX_FILE_SIZE_MB=20
MAX_TOTAL_SIZE_MB=100
TRANSFER_EXPIRY_MINUTES=10
TRANSFER_EXPIRY_OPTIONS_MINUTES=5,10,30
# Longest expiry a sender can choose with the custom "+" option (1440 = 24 hours)
MAX_EXPIRY_MINUTES=1440

# Storage: false (default) = local disk (uploads/transfers), true = S3
USE_S3=false
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible services (Cloudflare R2, MinIO)
# S3_ENDPOINT=
# S3_PREFIX=transfers/

# Public URL of the frontend, used in links inside emails (defaults to the first ALLOWED_CLIENTS entry)
FRONTEND_URL=http://localhost:3001

# Where messages from the Contact page are delivered (defaults to MAIL_USER)
CONTACT_EMAIL=

# ---- Abuse protection (defaults shown) ----
# Total disk SendAnyFile may use (MB). 0 = no cap.
MAX_STORAGE_MB=5120
MAX_CONCURRENT_UPLOADS=4
UPLOADS_PER_HOUR=20
CLASSIC_UPLOADS_PER_HOUR=10
# Each file can be downloaded 1..MAX_DOWNLOADS times; the sender picks, default is DEFAULT_DOWNLOADS (max 5)
MAX_DOWNLOADS=5
DEFAULT_DOWNLOADS=1
MAX_CONCURRENT_ZIPS=4
EMAILS_PER_HOUR=10
EMAILS_PER_RECIPIENT_PER_HOUR=3
EMAILS_PER_DAY=300
# Wrong-key lockouts: per IP in 10 min, and site-wide per minute
KEY_FAILS_PER_IP=10
KEY_FAILS_GLOBAL_PER_MIN=120
# File types that are refused (comma separated, no dots)
BLOCKED_EXTENSIONS=exe,scr,bat,cmd,com,msi,msp,vbs,vbe,jse,wsf,ps1,jar,pif,lnk,hta,cpl,dll,reg
# Number of proxies in front of the app (Render = 1). Use false when exposed directly.
TRUST_PROXY=1
# Browser origins allowed to call the API: add your live frontend URL here!
# ALLOWED_CLIENTS=https://your-frontend.example.com,http://localhost:3001

# ---- Admin sign-in (/admin/config) ----
# Users live in the database; passwords are stored only as scrypt hashes.
# ADMIN_ID / ADMIN_SECRET are used ONCE, to create the first admin when none exists.
# Later changes: node scripts/set-admin-password.js <new-password>
# Login password = <password> + DDHHmm in IST (e.g. abc + 141640), unless LOGIN_TIME_SUFFIX=false.
# ADMIN_ID=admin
# ADMIN_SECRET=change-me-to-a-long-random-value
# LOGIN_TIME_SUFFIX=true
# Signs the access tokens: 32+ random characters (keep it secret; without it sessions end on restart).
# JWT_ACCESS_SECRET=
# Access token lifetime and the total session length (refresh never extends it), in minutes.
# ACCESS_TOKEN_MINUTES=5
# SESSION_MINUTES=15

# TEMPORARY testing only: allow pages from any address to call the API. Remove after testing!
# ALLOW_ALL_ORIGINS=true
